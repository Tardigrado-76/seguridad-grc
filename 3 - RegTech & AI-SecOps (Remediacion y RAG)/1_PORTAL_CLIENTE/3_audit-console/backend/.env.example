# ──────────────────────────────────────────────────────────────────
# Audit_Console Backend — Environment Variables
# Copia este archivo como .env y configura los valores reales.
# NUNCA commitear .env al repositorio.
# ──────────────────────────────────────────────────────────────────

# Entorno de ejecución
APP_ENV=development                    # development | production
APP_VERSION=1.0.0

# Servidor FastAPI
HOST=127.0.0.1
PORT=8000

# CORS — Orígenes permitidos (separados por coma)
# En producción, reemplazar con el dominio real del frontend
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Timeout máximo para ejecución de scripts (segundos)
# Scripts que superen este tiempo serán terminados con SIGTERM
SCRIPT_TIMEOUT_SECONDS=300

# Nivel de log
LOG_LEVEL=INFO
