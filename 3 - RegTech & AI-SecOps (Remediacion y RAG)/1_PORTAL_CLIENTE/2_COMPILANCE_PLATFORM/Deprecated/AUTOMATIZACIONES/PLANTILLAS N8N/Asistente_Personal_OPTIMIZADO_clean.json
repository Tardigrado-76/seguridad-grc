      "parameters": {
        "jsCode": "return items.map(item => {\n  const originalText = $input.first().json.output;\n  if (typeof originalText !== 'string') return { json: { cleaned: '' } };\n  let cleaned = originalText\n    .replace(/<[^>]*>/g, '')\n    .replace(/\\r?\\n|\\r/g, ' ')\n    .replace(/\\s+/g, ' ')\n    .trim();\n  return { json: { cleaned } };\n});"
