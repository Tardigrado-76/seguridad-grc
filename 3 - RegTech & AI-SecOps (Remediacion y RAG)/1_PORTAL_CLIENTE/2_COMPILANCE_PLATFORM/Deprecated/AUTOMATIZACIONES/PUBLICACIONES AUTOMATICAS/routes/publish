// Función para publicar en LinkedIn
async function publishToLinkedIn(accessToken, caption, filePath) {
  try {
    const response = await axios.post(
      'https://api.linkedin.com/v2/ugcPosts',
      {
        author: 'urn:li:person:PERSON_ID', // Requiere ID de persona
        lifecycleState: 'PUBLISHED',
        specificContent: {
          'com.linkedin.ugc.ShareContent': {
            shareCommentary: {
              text: caption
            },
            shareMediaCategory: 'IMAGE'
          }
        },
        visibility: {
          'com.linkedin.ugc.MemberNetworkVisibility': 'PUBLIC'
        }
      },
      {
        headers: {
          'Authorization': `Bearer ${accessToken}`,
          'Content-Type': 'application/json'
        }
      }
    );
    
    return { success: true, data: response.data };
  } catch (error) {
    console.error('Error publicando en LinkedIn:', error.response?.data || error.message);
    return { success: false, error: error.message };
  }
}

// Ruta principal de publicación
router.post('/publish', upload.array('files', 10), async (req, res) => {
  try {
    const { caption, networks } = req.body;
    const files = req.files;
    
    if (!files || files.length === 0) {
      return res.status(400).json({ error: 'No se subieron archivos' });
    }
    
    const networkConfig = JSON.parse(networks);
    const results = [];
    
    // Publicar en cada red seleccionada
    for (const file of files) {
      if (networkConfig.facebook && req.session.facebookToken) {
        const result = await publishToFacebook(
          req.session.facebookToken,
          caption,
          file.path
        );
        results.push({ network: 'Facebook', ...result });
      }
      
      if (networkConfig.instagram && req.session.instagramToken) {
        const result = await publishToInstagram(
          req.session.instagramToken,
          caption,
          file.path
        );
        results.push({ network: 'Instagram', ...result });
      }
      
      if (networkConfig.twitter && req.session.twitterToken) {
        const result = await publishToTwitter(
          req.session.twitterToken,
          req.session.twitterTokenSecret,
          caption,
          file.path
        );
        results.push({ network: 'Twitter', ...result });
      }
      
      if (networkConfig.linkedin && req.session.linkedinToken) {
        const result = await publishToLinkedIn(
          req.session.linkedinToken,
          caption,
          file.path
        );
        results.push({ network: 'LinkedIn', ...result });
      }
      
      // Eliminar archivo temporal después de publicar
      fs.unlinkSync(file.path);
    }
    
    const successCount = results.filter(r => r.success).length;
    const message = `Publicado exitosamente en ${successCount} de ${results.length} redes`;
    
    res.json({ message, results });
    
  } catch (error) {
    console.error('Error en publicación:', error);
    res.status(500).json({ error: 'Error al publicar contenido' });
  }
});

module.exports = router;